{
  "name": "oi-race-simulation",
  "compatibility_date": "2026-08-17",
  // Keep the workers.dev URL alive as a fallback and debugging entry point.
  "workers_dev": true,
  // Served straight off Cloudflare's edge. Routing this through the saas.sin.fan
  // optimized-IP edge is not possible: a SaaS edge has to pull from a routable
  // origin IP, and a Worker only exists behind Cloudflare's own anycast, which
  // Cloudflare will not connect back to. That path returns a permanent 522.
  //
  // The hostname deliberately avoids game.revlm.com. The SaaS certificate that
  // saas.sin.fan serves for the revlm.com apex carries the SAN set
  // "revlm.com, game.revlm.com, *.game.revlm.com" on a restricted BYOIP edge
  // (162.159.36.0/24). Browsers coalesce an existing HTTP/2 connection to the
  // apex onto any hostname that certificate covers, so requests for
  // game.revlm.com landed on an edge IP this zone is not authorised to use and
  // Cloudflare answered "Error 1034 Edge IP Restricted". oi-game.revlm.com is
  // outside that SAN set (the wildcard only matches *.game.revlm.com), so no
  // coalescing happens.
  "routes": [
    { "pattern": "oi-game.revlm.com", "custom_domain": true }
  ],
  "main": "./src/index.js",
  "assets": {
    // Only the vite build output is uploaded, so nothing outside it can ever be
    // published. Run `npm run build` before deploying; `npm run deploy` does both.
    "directory": "./dist",
    // The Worker needs the binding to serve pages itself once it has decided a
    // request is not for the API.
    "binding": "ASSETS",
    // Without this the asset router answers /api/* with the SPA 404 path before
    // the Worker is ever invoked.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oi-race-db",
      "database_id": "79ac59b9-c8ea-47ac-865d-0e85e95f9145"
    }
  ],
  "observability": {
    "enabled": true
  }
}
